// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LolRole {
  TOP
  JUNGLE
  MID
  ADC
  SUPPORT
}

enum AuctionStatus {
  DRAFT
  READY
  RUNNING
  PAUSED
  FINISHED
  CANCELED
}

enum ParticipantStatus {
  WAITING
  BIDDING
  SOLD
  UNSOLD
  CAPTAIN
}

enum ChatType {
  GLOBAL
  TEAM
}

model User {
  id                    String                @id @default(cuid())
  authUserId            String                @unique
  discordId             String                @unique
  discordUsername       String?
  discordAvatarUrl      String?
  nickname              String                @unique
  customProfileImageUrl String?
  bio                   String?
  mainRole              LolRole?
  subRole               LolRole?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  lolAccounts           LolAccount[]
  lolStats              UserLolStats?
  ownedAuctions         Auction[]             @relation("AuctionOwner")
  auctionParticipants   AuctionParticipant[]
  captainTeams          AuctionTeam[]         @relation("TeamCaptain")
  chatMessages          ChatMessage[]
  internalMatchPlayers  InternalMatchPlayer[]
  auctionStats          UserAuctionStats?
  auctionSoldRecords    AuctionSoldRecord[]
}

model LolAccount {
  id        String   @id @default(cuid())
  userId    String
  gameName  String
  tagLine   String
  puuid     String?
  region    String   @default("KR")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameName, tagLine])
}

model UserLolStats {
  id                    String    @id @default(cuid())
  userId                String    @unique
  currentTier           String?
  currentRank           String?
  peakTier              String?
  peakRank              String?
  mostChampion1         String?
  mostChampion2         String?
  mostChampion3         String?
  mostChampion1ImageUrl String?
  mostChampion2ImageUrl String?
  mostChampion3ImageUrl String?
  refreshedAt           DateTime?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Auction {
  id                         String               @id @default(cuid())
  code                       String               @unique
  title                      String
  ownerId                    String
  teamCount                  Int
  membersPerTeam             Int
  auctionSeconds             Int
  extendSeconds              Int
  startPoints                Int
  status                     AuctionStatus        @default(DRAFT)
  currentTargetParticipantId String?
  currentBidId               String?
  currentRoundEndAt          DateTime?
  pausedAt                   DateTime?
  pausedRemainingMs          Int?
  lastActivityAt             DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  owner                      User                 @relation("AuctionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  teams                      AuctionTeam[]
  participants               AuctionParticipant[]
  bids                       AuctionBid[]
  messages                   ChatMessage[]
  internalMatches            InternalMatch[]
  auctionSoldRecords         AuctionSoldRecord[]
  lastSoldUserStats          UserAuctionStats[]   @relation("LastSoldAuction")
}

model AuctionParticipant {
  id           String              @id @default(cuid())
  auctionId    String
  userId       String
  status       ParticipantStatus   @default(WAITING)
  teamId       String?
  soldPrice    Int?
  auctionOrder Int?
  lastSeenAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  auction      Auction             @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         AuctionTeam?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  soldRecords  AuctionSoldRecord[]

  @@unique([auctionId, userId])
}

model AuctionTeam {
  id           String                @id @default(cuid())
  auctionId    String
  name         String
  captainId    String?
  pointsLeft   Int
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  auction      Auction               @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  captain      User?                 @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: SetNull)
  members      AuctionParticipant[]
  matchPlayers InternalMatchPlayer[]
  soldRecords  AuctionSoldRecord[]

  @@unique([auctionId, name])
}

model AuctionBid {
  id                  String   @id @default(cuid())
  auctionId           String
  bidderTeamId        String
  bidderCaptainId     String
  targetParticipantId String
  amount              Int
  createdAt           DateTime @default(now())
  auction             Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(cuid())
  auctionId String
  senderId  String
  teamId    String?
  type      ChatType
  message   String
  createdAt DateTime @default(now())
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model InternalMatch {
  id               String                @id @default(cuid())
  auctionId        String
  gameNumber       Int
  matchFingerprint String?
  screenshotUrl    String?
  resultText       String?
  winningSide      String
  playedAt         DateTime              @default(now())
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  auction          Auction               @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  players          InternalMatchPlayer[]

  @@unique([auctionId, gameNumber])
  @@unique([auctionId, matchFingerprint])
}

model InternalMatchPlayer {
  id               String        @id @default(cuid())
  internalMatchId  String
  userId           String?
  auctionTeamId    String?
  side             String
  rawPlayerName    String?
  championName     String?
  championId       String?
  championImageUrl String?
  kills            Int?
  deaths           Int?
  assists          Int?
  win              Boolean
  confidence       Float?
  createdAt        DateTime      @default(now())
  internalMatch    InternalMatch @relation(fields: [internalMatchId], references: [id], onDelete: Cascade)
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  auctionTeam      AuctionTeam?  @relation(fields: [auctionTeamId], references: [id], onDelete: SetNull)
}

model UserAuctionStats {
  id                String    @id @default(cuid())
  userId            String    @unique
  totalSoldPrice    Int       @default(0)
  soldCount         Int       @default(0)
  averageSoldPrice  Float     @default(0)
  lastSoldPrice     Int?
  lastSoldAuctionId String?
  lastSoldAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSoldAuction   Auction?  @relation("LastSoldAuction", fields: [lastSoldAuctionId], references: [id], onDelete: SetNull)
}

model AuctionSoldRecord {
  id            String             @id @default(cuid())
  auctionId     String
  participantId String
  userId        String
  teamId        String
  soldPrice     Int
  soldAt        DateTime           @default(now())
  createdAt     DateTime           @default(now())
  auction       Auction            @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  participant   AuctionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  team          AuctionTeam        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([auctionId, participantId])
  @@index([userId])
  @@index([auctionId])
}
